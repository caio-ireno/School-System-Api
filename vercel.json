{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/alunos",
      "dest": "/api/aluno/aluno_routes.py"
    },
    {
      "src": "/turmas",
      "dest": "/api/turma_routes.py"
    },
    {
      "src": "/professores",
      "dest": "/app/professor_routes.py"
    }
  ]
}
